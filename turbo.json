{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "content/docs/api/**"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "@primitree/hooks#test": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "@primitree/hooks#test:coverage": {
      "dependsOn": ["build"],
      "outputs": ["coverage/**"]
    },
    "@primitree/cli#test": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "@primitree/cli#test:coverage": {
      "dependsOn": ["build"],
      "outputs": ["coverage/**"]
    },
    "@primitree/hooks#typecheck": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "check:publint": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "check:attw": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "check:size": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
