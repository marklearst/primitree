{
  "name": "figmavars-docs",
  "version": "5.0.0",
  "private": true,
  "description": "FigmaVars documentation site (figmavars.com)",
  "scripts": {
    "build": "fumadocs-mdx && next build",
    "dev": "next dev --port 3000",
