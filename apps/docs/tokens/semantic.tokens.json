      "keyword": {
        "$value": "{primitives.color.red.72}"
      },
      "reference": {
        "$value": "{primitives.color.brand.72}",
        "$description": "A DTCG alias in sample code: the thing Primitree checks."
      },
      "fail": {
        "$value": "{primitives.color.red.72}",
