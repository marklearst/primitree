        }
      },
      "warn": {
        "background": {
          "$type": "color",
          "$value": "{semantic.status.warnOnIsland}"
        }
      },
      "transition": {
        "duration": {
          "$type": "duration",
          "$value": "{semantic.motion.duration.handoff}"
