{
  "name": "figmavars-plugin",
  "version": "5.0.0",
  "private": true,
  "description": "Official FigmaVars plugin: export local variables to variables.json",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.ui.json"
  },
  "dependencies": {
    "@figmavars/plugin-export": "workspace:*"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.119.0",
    "esbuild": "^0.27.0",
    "jsdom": "29.1.1",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  }
}
