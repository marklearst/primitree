{
  "name": "@figmavars/cli",
  "version": "5.0.0",
  "description": "Build, compare, check, scaffold, and export Figma Variables token projects.",
  "author": "Mark Learst",
  "license": "MIT",
  "type": "module",
  "bin": {
    "figma-vars": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "figma",
    "figma variables",
    "design tokens",
    "dtcg",
    "style-dictionary",
    "terrazzo",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marklearst/figmavars.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/marklearst/figmavars/issues"
  },
  "homepage": "https://github.com/marklearst/figmavars#readme",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/marklearst"
  },
  "dependencies": {
    "@figmavars/core": "workspace:*",
    "@figmavars/dtcg": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^4.1.10",
    "tsup": "^8.5.1",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  }
}
