{
  "name": "@figma-vars/cli",
  "version": "0.1.0",
  "description": "The FigmaVars CLI: export Figma variables, build a DTCG design token pipeline, diff token changes, and validate output.",
  "author": "Mark Learst",
  "license": "MIT",
  "type": "module",
  "bin": {
    "figma-vars": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "keywords": [
    "figma",
    "figma variables",
    "design tokens",
    "dtcg",
    "style-dictionary",
    "terrazzo",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marklearst/figma-vars-hooks.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/marklearst/figma-vars-hooks/issues"
  },
  "homepage": "https://github.com/marklearst/figma-vars-hooks#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/marklearst"
  },
  "dependencies": {
    "@figma-vars/core": "workspace:*",
    "@figma-vars/dtcg": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@vitest/coverage-v8": "^4.1.10",
    "tsup": "^8.5.1",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  }
}
