{
  "name": "@primitree/cli",
  "version": "1.0.0",
  "description": "Build, compare, check, scaffold, and export Figma Variables token projects.",
  "author": "Mark Learst",
  "license": "MIT",
  "type": "module",
  "bin": {
    "primitree": "./dist/index.js"
  },
  "exports": {
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "figma",
    "figma variables",
    "design tokens",
    "dtcg",
    "style-dictionary",
    "terrazzo",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marklearst/primitree.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/marklearst/primitree/issues"
  },
  "homepage": "https://github.com/marklearst/primitree#readme",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/marklearst"
  },
  "dependencies": {
    "@primitree/core": "workspace:*",
    "@primitree/dtcg": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^4.1.10",
    "tsup": "^8.5.1",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  }
}
