{
  "name": "@figmavars/hooks",
  "version": "5.0.0",
  "description": "Typed React hooks for Figma Variables and design tokens: consume built DTCG artifacts on any plan (useToken, useTheme), or manage variables live via the REST API.",
  "author": "Mark Learst",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "typesVersions": {
    "*": {
      "core": [
        "dist/core.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "scripts/export-variables.mjs"
  ],
  "bin": {
    "figma-vars-export": "./scripts/export-variables.mjs"
  },
  "keywords": [
    "figma",
    "figma variables",
    "figma tokens",
    "react",
    "react hooks",
    "design tokens",
    "theme",
    "storybook",
    "vite",
    "typescript",
    "design system"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marklearst/figmavars.git",
    "directory": "packages/hooks"
  },
  "bugs": {
    "url": "https://github.com/marklearst/figmavars/issues"
  },
  "homepage": "https://github.com/marklearst/figmavars#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc && vite build",
    "postbuild": "node scripts/postbuild.mjs",
    "prepublishOnly": "pnpm build",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch",
    "typecheck": "tsc --noEmit",
    "create:docs": "npx typedoc src/index.ts --out docs-site/api",
    "check:publint": "publint",
    "check:attw": "attw --pack .",
    "check:size": "size-limit",
    "check:release": "pnpm run build && pnpm run check:publint && pnpm run check:attw && pnpm run check:size"
  },
  "peerDependencies": {
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "swr": "^2.3.7"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.mjs"
    },
    "./core": {
      "import": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.mjs"
      },
      "require": {
        "types": "./dist/core.d.cts",
        "default": "./dist/core.cjs"
      },
      "default": "./dist/core.mjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/marklearst"
  },
  "dependencies": {
    "@figmavars/core": "workspace:*",
    "@figmavars/dtcg": "workspace:*"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.4",
    "@microsoft/api-extractor": "^7.58.9",
    "@size-limit/preset-small-lib": "^12.1.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "jsdom": "^29.1.1",
    "publint": "^0.3.21",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "size-limit": "^12.1.0",
    "swr": "^2.4.2",
    "typescript": "~6.0.3",
    "vite": "^8.1.3",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10"
  },
  "size-limit": [
    {
      "name": "modern ESM entry",
      "path": "dist/index.mjs",
      "import": "{ useVariables }",
      "limit": "10 kB"
    }
  ]
}
