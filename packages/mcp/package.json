{
  "name": "@figmavars/mcp",
  "version": "5.0.0",
  "description": "MCP server that makes your design tokens AI-legible: list, get, resolve, search, and diff Figma variables / DTCG tokens from any MCP client.",
  "author": "Mark Learst",
  "license": "MIT",
  "type": "module",
  "bin": {
    "figma-vars-mcp": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "keywords": [
    "mcp",
    "model context protocol",
    "figma",
    "figma variables",
    "design tokens",
    "dtcg",
    "ai"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marklearst/figmavars.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/marklearst/figmavars/issues"
  },
  "homepage": "https://github.com/marklearst/figmavars#readme",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/marklearst"
  },
  "dependencies": {
    "@figmavars/core": "workspace:*",
    "@figmavars/dtcg": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@vitest/coverage-v8": "^4.1.10",
    "tsup": "^8.5.1",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  }
}
