{
  "name": "@primitree/mcp",
  "version": "1.0.0-next.0",
  "description": "MCP server for listing, resolving, searching, and comparing Primitree design tokens.",
  "author": "Mark Learst",
  "license": "MIT",
  "type": "module",
  "bin": {
    "primitree-mcp": "./dist/cli.js"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "keywords": [
    "mcp",
    "model context protocol",
    "figma",
    "figma variables",
    "design tokens",
    "dtcg",
    "ai"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marklearst/primitree.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/marklearst/primitree/issues"
  },
  "homepage": "https://github.com/marklearst/primitree#readme",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/marklearst"
  },
  "dependencies": {
    "@primitree/core": "workspace:*",
    "@primitree/dtcg": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^4.1.10",
    "tsup": "^8.5.1",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  }
}
