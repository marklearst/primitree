{
  "$schema": "https://www.designtokens.org/schemas/2025.10/resolver.json",
  "name": "Golden Fixture",
  "version": "2025.10",
  "description": "Generated by @figmavars/dtcg from a Figma variables export.",
  "sets": {
    "primitives": {
      "sources": [
        {
          "$ref": "./primitives.tokens.json"
        }
      ]
    },
    "semantic": {
      "sources": [
        {
          "$ref": "./semantic.tokens.json"
        }
      ]
    },
    "density": {
      "sources": [
        {
          "$ref": "./density.tokens.json"
        }
      ]
    }
  },
  "modifiers": {
    "semantic": {
      "description": "Figma modes for the \"Semantic\" collection",
      "contexts": {
        "light": [],
        "dark": [
          {
            "$ref": "./semantic.dark.tokens.json"
          }
        ]
      },
      "default": "light"
    },
    "density": {
      "description": "Figma modes for the \"Density\" collection",
      "contexts": {
        "comfortable": [],
        "compact": [
          {
            "$ref": "./density.compact.tokens.json"
          }
        ]
      },
      "default": "comfortable"
    }
  },
  "resolutionOrder": [
    {
      "$ref": "#/sets/primitives"
    },
    {
      "$ref": "#/sets/semantic"
    },
    {
      "$ref": "#/sets/density"
    },
    {
      "$ref": "#/modifiers/semantic"
    },
    {
      "$ref": "#/modifiers/density"
    }
  ]
}
