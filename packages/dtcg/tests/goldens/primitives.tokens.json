{
  "primitives": {
    "color": {
      "blue": {
        "300": {
          "$type": "color",
          "$value": {
            "colorSpace": "srgb",
            "components": [
              0.55,
              0.7,
              1
            ],
            "alpha": 1,
            "hex": "#8cb3ff"
          },
          "$extensions": {
            "com.figma-vars": {
              "variableId": "VariableID:1:102",
              "collectionId": "VariableCollectionId:1:100",
              "collectionName": "Primitives",
              "scopes": [
                "ALL_SCOPES"
              ]
            }
          }
        },
        "500": {
          "$type": "color",
          "$value": {
            "colorSpace": "srgb",
            "components": [
              0.2,
              0.4,
              1
            ],
            "alpha": 1,
            "hex": "#3366ff"
          },
          "$description": "Primary blue",
          "$extensions": {
            "com.figma-vars": {
              "variableId": "VariableID:1:101",
              "collectionId": "VariableCollectionId:1:100",
              "collectionName": "Primitives",
              "scopes": [
                "ALL_SCOPES"
              ],
              "codeSyntax": {
                "WEB": "var(--color-blue-500)"
              }
            }
          }
        }
      }
    },
    "radius": {
      "sm": {
        "$type": "dimension",
        "$value": {
          "value": 4,
          "unit": "px"
        },
        "$description": "Small corner radius",
        "$extensions": {
          "com.figma-vars": {
            "variableId": "VariableID:1:103",
            "collectionId": "VariableCollectionId:1:100",
            "collectionName": "Primitives",
            "scopes": [
              "CORNER_RADIUS"
            ]
          }
        }
      }
    },
    "space": {
      "2": {
        "$type": "dimension",
        "$value": {
          "value": 8,
          "unit": "px"
        },
        "$extensions": {
          "com.figma-vars": {
            "variableId": "VariableID:1:104",
            "collectionId": "VariableCollectionId:1:100",
            "collectionName": "Primitives",
            "scopes": [
              "GAP",
              "WIDTH_HEIGHT"
            ]
          }
        }
      }
    },
    "font": {
      "family": {
        "sans": {
          "$type": "fontFamily",
          "$value": "Inter",
          "$extensions": {
            "com.figma-vars": {
              "variableId": "VariableID:1:105",
              "collectionId": "VariableCollectionId:1:100",
              "collectionName": "Primitives",
              "scopes": [
                "FONT_FAMILY"
              ]
            }
          }
        }
      }
    },
    "feature": {
      "rounded": {
        "$type": "boolean",
        "$value": true,
        "$description": "Toggle rounded corners",
        "$extensions": {
          "com.figma-vars": {
            "variableId": "VariableID:1:106",
            "collectionId": "VariableCollectionId:1:100",
            "collectionName": "Primitives",
            "hiddenFromPublishing": true,
            "resolvedType": "BOOLEAN"
          }
        }
      }
    },
    "opacity": {
      "disabled": {
        "$type": "number",
        "$value": 0.4,
        "$extensions": {
          "com.figma-vars": {
            "variableId": "VariableID:1:107",
            "collectionId": "VariableCollectionId:1:100",
            "collectionName": "Primitives",
            "scopes": [
              "OPACITY"
            ]
          }
        }
      }
    }
  }
}
