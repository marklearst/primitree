{
  "primitives": {
    "color": {
      "blue": {
        "500": {
          "$type": "color",
          "$value": {
            "colorSpace": "srgb",
            "components": [0.2, 0.4, 1],
            "alpha": 1
          }
        }
      },
      "green": {
        "500": {
          "$type": "color",
          "$value": {
            "colorSpace": "srgb",
            "components": [0.203922, 0.827451, 0.6],
            "alpha": 1
          }
        }
      },
      "gray": {
        "50": {
          "$type": "color",
          "$value": {
            "colorSpace": "srgb",
            "components": [0.976471, 0.980392, 0.984314],
            "alpha": 1
          }
        },
        "900": {
          "$type": "color",
          "$value": {
            "colorSpace": "srgb",
            "components": [0.066667, 0.094118, 0.152941],
            "alpha": 1
          }
        }
      }
    },
    "radius": {
      "md": {
        "$type": "dimension",
        "$value": {
          "value": 6,
          "unit": "px"
        }
      }
    },
    "space": {
      "4": {
        "$type": "dimension",
        "$value": {
          "value": 16,
          "unit": "px"
        }
      }
    }
  },
  "semantic": {
    "color": {
      "bg": {
        "brand": {
          "$type": "color",
          "$value": "{primitives.color.blue.500}"
        }
      },
      "fg": {
        "default": {
          "$type": "color",
          "$value": "{primitives.color.gray.900}"
        }
      }
    },
    "radius": {
      "control": {
        "$type": "dimension",
        "$value": "{primitives.radius.md}"
      }
    },
    "space": {
      "inset": {
        "$type": "dimension",
        "$value": "{primitives.space.4}"
      }
    }
  },
  "component": {
    "button": {
      "bg": {
        "$type": "color",
        "$value": "{primitives.color.blue.500}"
      },
      "radius": {
        "$type": "dimension",
        "$value": "{semantic.radius.control}"
      }
    },
    "focus": {
      "ring": {
        "$type": "color",
        "$value": "{semantic.color.bg.brand}"
      }
    },
    "nav": {
      "active": {
        "bg": {
          "$type": "color",
          "$value": "{semantic.color.bg.brand}"
        }
      }
    },
    "card": {
      "inset": {
        "$type": "dimension",
        "$value": "{semantic.space.inset}"
      }
    }
  }
}
