{
  "name": "figma-vars",
  "private": true,
  "description": "FigmaVars — turn a Figma variables export into a production design token pipeline. Monorepo for @figma-vars/* packages.",
  "author": "Mark Learst",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "dev": "turbo run dev",
    "lint": "biome format --write .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:release": "turbo run build check:publint check:attw check:size",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.5",
    "prettier": "^3.6.2",
    "turbo": "^2.5.0"
  }
}
